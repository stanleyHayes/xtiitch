# Affiliate portal (SSR React Router app). These are runtime, server-side env
# vars — set them in the hosting environment (Vercel/Render/Fly/Docker), not
# baked into the client bundle. Copy to .env for local dev if your runner loads
# dotenv; otherwise export them in your shell.

# Base origin of the Xtiitch API — WITHOUT the /v1 suffix, no trailing slash.
# The app appends /v1/... itself. Defaults to http://localhost:8080 if unset.
XTIITCH_API_URL=http://localhost:8080

# Secret that signs the affiliate session cookie. MUST be a strong, random
# value of at least 32 characters in production — production refuses to boot
# without one (a default dev secret is used when unset in development, which
# is insecure for prod).
SESSION_SECRET=change-me-to-a-long-random-string

# Set to "production" when hosting (enforces secure cookies and the
# SESSION_SECRET requirement above).
NODE_ENV=development
