{
  "name": "@xtiitch/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "exports": {
    ".": "./src/surfaces.mjs"
  },
  "scripts": {
    "android": "expo start --android",
    "check": "node --check src/surfaces.mjs && tsc --noEmit && node --test test/*.test.mjs",
    "ios": "expo start --ios",
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
